# Channel listing + first download attempt
YOUTUBE_MEDIA_RAPIDAPI_KEY=replace_with_your_rapidapi_key

# Download fallback used when youtube-media-downloader returns a 403/404/etc.
YOUTUBE_FAST_RAPIDAPI_KEY=replace_with_your_rapidapi_key

# RapidAPI quality id for the fallback /download_video/{videoId} endpoint.
# 18 is a broadly supported progressive MP4 quality; change it to another
# provider-supported quality id such as 137 when desired.
YOUTUBE_FAST_DOWNLOAD_QUALITY=18
